{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "generador-de-nombres.vercel.app" }],
      "destination": "https://generadordenombres.net/:path*",
      "permanent": true
    },
    {
      "source": "/nombres-perritas-chihuahua",
      "destination": "/perritas-chihuahua",
      "permanent": true
    },
    {
      "source": "/nombres-para-perritas",
      "destination": "/nombres-perritas",
      "permanent": true
    },
    {
      "source": "/nombres-para-gatos",
      "destination": "/nombres-gatos",
      "permanent": true
    }
  ]
}
