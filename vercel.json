{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://*.vercel-insights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.vercel-insights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "generador-de-nombres.vercel.app" }],
      "destination": "https://generadordenombres.net/:path*",
      "permanent": true
    },
    {
      "source": "/nombres-perritas-chihuahua",
      "destination": "/perritas-chihuahua",
      "permanent": true
    },
    {
      "source": "/nombres-para-perritas",
      "destination": "/nombres-perritas",
      "permanent": true
    },
    {
      "source": "/nombres-para-gatos",
      "destination": "/nombres-gatos",
      "permanent": true
    }
  ]
}
